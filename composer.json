{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "andronewille/sluis",
    "description": "Masks personal data in Dutch text on its way into an AI system, and puts it back on the way out. Offline, no dependency.",
    "keywords": ["pii", "anonymisation", "dutch", "gdpr", "offline"],
    "license": "EUPL-1.2",
    "homepage": "https://github.com/Andronewille/sluis",
    "support": {
        "issues": "https://github.com/Andronewille/sluis/issues",
        "source": "https://github.com/Andronewille/sluis"
    },
    "type": "library",
    "require": {
        "php": "^8.5",
        "ext-mbstring": "*",
        "ext-sodium": "*"
    },
    "autoload": {
        "psr-4": {
            "Sluis\\": "src/"
        }
    },
    "bin": ["bin/sluis"],
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
