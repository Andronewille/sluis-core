#!/usr/bin/env php
<?php

declare(strict_types=1);

use Sluis\Infrastructure\Cli\Console;

// Through Composer's own `vendor/bin/sluis`, which says where its autoloader is; then
// installed as a dependency, installed on its own, or run out of the workspace.
$composer = $_composer_autoload_path ?? null;

foreach ([is_string($composer) ? $composer : '', __DIR__.'/../../../autoload.php', __DIR__.'/../vendor/autoload.php', __DIR__.'/../../../vendor/autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;

        break;
    }
}

exit((new Console)->run($argv ?? [], STDIN, STDOUT, STDERR));
